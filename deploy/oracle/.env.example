# Copy to .env on the server and fill in. Never commit the real file.
API_DOMAIN=api.yourdomain.com
POSTGRES_PASSWORD=change-me-to-something-long

# --- Auth (Supabase project you already have) -----------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
CORS_ORIGINS=https://your-site.vercel.app

# --- Secrets --------------------------------------------------------------------------
STORAGE_SIGNING_KEY=generate-with-openssl-rand-hex-32
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
APIFY_TOKEN=

# --- Storage: Cloudflare R2 (10 GB free, no charge for downloads) -----------------------
STORAGE_BACKEND=s3
S3_BUCKET=clip2easy-media
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Leave STORAGE_BACKEND=local instead to keep files on the server's own disk:
# ALLOW_SINGLE_NODE_STORAGE=true

# --- Owner test credits (optional) ------------------------------------------------------
OWNER_EMAILS=
