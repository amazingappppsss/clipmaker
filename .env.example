# ClipMaker configuration. Copy to backend/.env (backend) and frontend/.env.local (frontend).
# Never commit real values. In production set these as secrets in your hosting platform.

# ---------------- Backend (backend/.env) ----------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
# Optional. Public address of this API for upload/download links. Leave unset to use the
# address the browser called (works on Railway/Render out of the box).
# API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=http://localhost:3000  # comma-separated frontend origins

DATABASE_URL=postgresql+psycopg://clipmaker:clipmaker@localhost:5432/clipmaker
REDIS_URL=redis://localhost:6379/0

# Auth — Supabase (Project Settings → API). SUPABASE_URL enables JWKS verification of
# asymmetric tokens; SUPABASE_JWT_SECRET verifies legacy HS256 tokens (and local dev tokens).
SUPABASE_URL=
SUPABASE_JWT_SECRET=local-dev-secret-at-least-32-characters-long
ENABLE_DEV_AUTH=true                # local login without Supabase. Refused in production.

# Storage — "local" for development, "s3" for Cloudflare R2 / any S3-compatible service.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.data/storage
STORAGE_SIGNING_KEY=change-me-for-anything-but-local-dev
S3_ENDPOINT_URL=                    # https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=3600

# Limits
MAX_UPLOAD_BYTES=5368709120         # 5 GiB
MAX_VIDEO_DURATION_SECONDS=14400    # 4 h
MIN_VIDEO_DURATION_SECONDS=30
RATE_LIMIT_PER_MINUTE=120

# AI providers (keys: set as secrets on your host, never commit)
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# Link import (YouTube). Importers are tried in order; "apify" needs APIFY_TOKEN and avoids
# YouTube's blocks on data-centre servers, "ytdlp" downloads directly from this server.
ENABLE_URL_IMPORT=true
URL_IMPORT_PROVIDERS=apify,ytdlp
APIFY_TOKEN=
APIFY_YOUTUBE_ACTOR=coder2077~youtube-video-downloader

# ---------------- Frontend (frontend/.env.local) ----------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # publishable key: safe in browsers
NEXT_PUBLIC_DEV_AUTH=true           # must be false/unset in production
# Dev/preview only: serve the API through the web server at /api (then NEXT_PUBLIC_API_URL=/api
# and backend API_PUBLIC_URL=/api). Leave unset in production.
API_PROXY_TARGET=
