  "components": {
    "schemas": {
      "AccountUsage": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "credits_balance": {
            "type": "integer",
            "title": "Credits Balance"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/UsageRecordOut"
            },
            "type": "array",
            "title": "History"
          },
          "plans": {
            "items": {
              "$ref": "#/components/schemas/PlanOut"
            },
            "type": "array",
            "title": "Plans"
          }
        },
        "type": "object",
        "required": [
          "email",
          "plan",
          "credits_balance",
          "history",
          "plans"
        ],
        "title": "AccountUsage",
        "description": "GET /account/usage response."
      },
      "ClipOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "status": {
            "$ref": "#/components/schemas/ClipStatus"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "hook": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hook"
          },
          "alt_titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alt Titles"
          },
          "social_caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Social Caption"
          },
          "hashtags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hashtags"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "start_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Seconds"
          },
          "end_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Seconds"
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rank",
          "status",
          "title",
          "hook",
          "alt_titles",
          "social_caption",
          "hashtags",
          "duration_seconds"
        ],
        "title": "ClipOut",
        "description": "A selected clip: its moment in the source video plus publishing metadata."
      },
      "ClipStatus": {
        "type": "string",
        "enum": [
          "planned",
          "rendering",
          "qa",
          "ready",
          "needs_review",
          "failed"
        ],
        "title": "ClipStatus",
        "description": "Lifecycle of a single generated clip."
      },
      "ContentCategory": {
        "type": "string",
        "enum": [
          "auto",
          "podcast",
          "interview",
          "educational",
          "business",
          "gaming"
        ],
        "title": "ContentCategory",
        "description": "User-selected content category (PRD \u00a74 step 2)."
      },
      "DevTokenOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          }
        },
